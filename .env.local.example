# ─────────────────────────────────────────────────────────────────────────────
# scribe.txt — Environment Variables
# Copy this file to .env.local and fill in your values before running locally.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL (e.g. https://abcxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon / Public API Key (from Supabase → Settings → API → anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pooled connection string for Prisma (from Supabase → Settings → Database → Connection Pooling)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Direct connection for Prisma migrations (from Supabase → Settings → Database → Connection String)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=

# Service role key (from Supabase → Settings → API → service_role key — keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI / Whisper ─────────────────────────────────────────────────────────
# Your OpenAI API key with access to the whisper-1 model
OPENAI_API_KEY=

# Base URL for the Whisper-compatible API.
# Default: OpenAI's own endpoint. To use a self-hosted Speaches server,
# change this to e.g. http://localhost:8000/v1 — no other code changes needed.
TRANSCRIBE_API_BASE_URL=https://api.openai.com/v1

# ── Inngest ──────────────────────────────────────────────────────────────────
# Get these from https://app.inngest.com → your app → Manage → Keys
# For local dev, run `npx inngest-cli@latest dev` and use the dev server keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Public URL of this app (used by Inngest to register the webhook)
# For local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
